# ============================================
# Agentic Learning System - Environment Config
# ============================================
# Copy this file to .env and fill in your keys
# NEVER commit the .env file to git!
# ============================================

# ---- Application Settings ----
APP_NAME=Agentic Learning System
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Database ----
# SQLite (local development)
DATABASE_URL=sqlite+aiosqlite:///./data/learning_system.db

# PostgreSQL (production - uncomment when deploying)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/learning_system

# ---- LLM Providers ----

# Ollama (Local) — No key needed, just run: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Google Gemini (Free) — Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq (Free) — Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# DeepSeek (Free) — Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_key_here

# ---- ChromaDB ----
CHROMA_PERSIST_DIR=./chroma_data

# ---- Server ----
HOST=0.0.0.0
PORT=8000
